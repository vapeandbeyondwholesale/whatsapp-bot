# Meta App Dashboard > WhatsApp > API Setup se ye values copy karein
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# Test karne ke liye apna whitelisted number (country code ke saath, bina + ke, e.g. 923001234567)
TEST_RECIPIENT_NUMBER=923xxxxxxxxx

# Webhook setup ke liye (aap khud ek random string choose kar lein, Meta Dashboard mein wahi enter karna hoga)
WEBHOOK_VERIFY_TOKEN=choose_any_random_string
PORT=3000

# platform.openai.com se apni API key generate karein
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Vercel par "Upstash Redis" integration add karne se ye khud fill ho jayenge
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
